      "key": "departure_count",
      "type": "number",
      "label": {
        "en": "Departures followed per stop",
        "fr": "Départs suivis par arrêt"
      },
      "description": {
        "en": "The next departures of each stop, between 1 and 8.",
        "fr": "Les prochains départs de chaque arrêt, entre 1 et 8."
      },
      "min": 1,
      "max": 8,
      "default": 4,
      "required": false
    },
    {
      "key": "delay_threshold",
      "type": "number",
      "label": {
        "en": "Delay threshold (min)",
        "fr": "Seuil de retard (min)"
      },
      "description": {
        "en": "From how many minutes a train counts as delayed (scenes, disrupted departures, colors).",
        "fr": "À partir de combien de minutes un train compte comme en retard (scènes, départs perturbés, couleurs)."
      },
      "min": 1,
      "max": 30,
      "default": 3,
      "required": false
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Departures refresh (min)",
        "fr": "Rafraîchissement des départs (min)"
      },
      "description": {
        "en": "Within the travel window (all day without one), between 1 and 30 minutes.",
        "fr": "Dans la plage horaire (toute la journée sans plage), entre 1 et 30 minutes."
      },
      "min": 1,
      "max": 30,
      "default": 2,
      "required": false
    },
    {
      "key": "traffic_interval",
      "type": "number",
      "label": {
        "en": "Traffic refresh (min)",
        "fr": "Rafraîchissement du trafic (min)"
      },
      "description": {
        "en": "Between 2 and 60 minutes.",
        "fr": "Entre 2 et 60 minutes."
      },
      "min": 2,
      "max": 60,
      "default": 5,
      "required": false
    },
    {
      "key": "departures_quota",
      "type": "number",
      "label": {
        "en": "Daily quota of departures",
        "fr": "Quota quotidien des départs"
      },
      "description": {
        "en": "The daily quota of the \"Prochains passages (requête unitaire)\" API on your account: 1 000 for a new one. Raise it here after asking PRIM for more (free).",
        "fr": "Le quota quotidien de l’API « Prochains passages (requête unitaire) » de votre compte : 1 000 pour un nouveau compte. Augmentez-le ici après en avoir demandé davantage à PRIM (gratuit)."
      },
      "min": 100,
      "max": 1000000,
      "default": 1000,
      "required": false
    }
